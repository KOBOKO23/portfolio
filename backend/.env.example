# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Production overrides (set these in Render dashboard, NOT here) ────────────
# SECRET_KEY=<50+ char random string — never commit the real value>
# DEBUG=False
# ALLOWED_HOSTS=<your-service>.onrender.com,koboko.dev,www.koboko.dev
# CORS_ALLOWED_ORIGINS=https://<your-vercel-project>.vercel.app,https://koboko.dev
# CSRF_TRUSTED_ORIGINS=https://<your-vercel-project>.vercel.app,https://koboko.dev
# ADMIN_URL=<secret-path>/   e.g. cms-2026/

# Production site URL (used in sitemap, emails)
SITE_URL=https://koboko.dev

# ── Database (default: SQLite for dev) ────────────────────────────────────────
# Render injects DATABASE_URL automatically when you add a PostgreSQL add-on.
# That single var is enough — dj-database-url parses it.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# Alternatively (or for any other host), use individual vars:
# DB_ENGINE=postgresql
# DB_NAME=portfolio
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── Weather (Open-Meteo — free, no API key needed) ───────────────────────────
DEFAULT_WEATHER_CITY=Nairobi,KE
DEFAULT_WEATHER_LAT=-1.2921
DEFAULT_WEATHER_LON=36.8219

# ── Email (console backend for dev — prints to terminal) ──────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP (Gmail example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Koboko Newsletter <noreply@koboko.dev>
# Admin alert email — contact form + volunteer submissions land here
# ADMIN_EMAIL=you@gmail.com

# ── Stripe — https://dashboard.stripe.com/apikeys ─────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── M-Pesa Daraja — https://developer.safaricom.co.ke ─────────────────────────
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be public HTTPS URL (use ngrok in dev: ngrok http 8000)
DARAJA_CALLBACK_URL=https://yourserver.com/api/payments/mpesa/callback/

# ── AWS S3 (static + media in production) ─────────────────────────────────────
USE_S3=False
